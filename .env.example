# 1Click. Without a key the fee is 0.25% instead of 0.20%.
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# An Arbitrum RPC for the spikes. The app has its own, rotated list below.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# A throwaway key funded with a few dollars, for spikes 03 and 04 ONLY.
# Never a key that has held real balances, and never committed.
SPIKE_PRIVATE_KEY=

# Where a spike refund should land. A shielded address you control.
SPIKE_ZEC_REFUND_ADDRESS=

# Circle Paymaster on Arbitrum.
CIRCLE_PAYMASTER_ADDRESS=
# The EIP-7702 delegate the session wallet points at. The paymaster
# refuses without it rather than guessing: a guessed delegate produces
# a user operation the bundler rejects.
CIRCLE_DELEGATE_ADDRESS=
BUNDLER_URL=

# Lighter.
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai

# ----------------------------------------------------------------------
# The browser build. Only VITE_-prefixed variables reach the client, and
# everything here is readable by anyone who opens the page: a static app
# has nowhere to keep a secret. Leave a value out and the movement that
# needs it refuses with a reason, which is the intended behaviour.
# ----------------------------------------------------------------------

# Arbitrum RPCs, comma-separated. Each session takes a different one, by
# key index, so no single provider can tell that two session wallets belong
# to the same person. One entry works and is not a rotation.
#
# No default on purpose: a public endpoint baked into the build would hand
# one company that picture for every user of this app.
#
# These calls go through the network adapter, so the provider sees a Tor or
# Nym exit rather than you, and the address it is asked about is public on
# chain anyway. The rotation is for what remains: who is asked about together.
#
# All three below answered 0xa4b1 from a browser origin on 2026-10-28 and
# allow cross-origin POST. The first is a privacy relay (metadata stripped in
# a TEE, by its own account — a promise, not something we can verify) and is
# rate-limited to 200 requests a day on the free tier, which is shared by IP
# and therefore shared with every other user leaving the same Nym gateway.
# VITE_ARBITRUM_RPC_URLS=https://public.1rpc.io/arb,https://arb1.arbitrum.io/rpc,https://arbitrum.drpc.org
VITE_ARBITRUM_RPC_URLS=

# The old singular name still works and is read as a list of one.
VITE_ARBITRUM_RPC_URL=

# Raises the 1Click fee from 0.25% to 0.20%.
VITE_ONECLICK_JWT=

# Which Zcash network this build is on: "main" or "test". Anything else is
# reported as a gap rather than guessed at, and leaving it blank means main.
#
# On "test" the app takes utest1 and ztestsapling1 addresses and refuses
# mainnet ones. It also refuses to start a session: 1Click prices mainnet
# assets and the Lighter and Arbitrum endpoints are mainnet, so there is
# nothing on the far side of the swap. Shielded testnet money can come in;
# it cannot make a round trip.
VITE_ZCASH_NETWORK=

# Run the real adapters against the real venues with the privacy gate off,
# so the end-to-end path can be exercised on a dev server. Set it to 1, then
# tick the override in the connection panel; nothing else changes, so every
# signature and every transfer is real.
#
# The cost, which is not recoverable: the venues see this machine's IP, and
# the two swap legs and the Lighter account are linkable to it and to each
# other, on a public chain, for good. Use a throwaway amount.
#
# It is read only when `import.meta.env.DEV` is true, which a build folds to
# false — so setting this in a deployed environment does nothing at all.
VITE_UNSAFE_LIVE_TEST=

# Circle Paymaster on Arbitrum, and the 7702 delegate. Without all three,
# gas falls back to ETH — which the wallet must be funded with, and that
# funding links the session.
VITE_BUNDLER_URL=
VITE_PAYMASTER_ADDRESS=
VITE_DELEGATE_ADDRESS=
