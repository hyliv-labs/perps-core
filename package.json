{
  "name": "coldtrail-zec",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private perpetual trading via a Zcash entry path. Shielded ZEC in, Lighter perps, shielded ZEC out. No backend.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "tsx --env-file-if-exists=.env",
    "fetch:signer": "node scripts/fetch-lighter-signer.mjs"
  },
  "dependencies": {
    "@nymproject/mix-fetch": "3.0.1",
    "idb": "8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
